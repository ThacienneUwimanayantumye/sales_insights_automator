# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024

# ── Google Drive ──────────────────────────────────────────────────────────────
# Service account JSON, or OAuth "Desktop app" client secrets JSON.
GDRIVE_CREDENTIALS_PATH=config/google_credentials.json
# Written by: python scripts/setup_gdrive_oauth.py (OAuth only; ignored for service accounts)
GDRIVE_TOKEN_PATH=config/gdrive_token.json
# Optional: python scripts/demo_ingestion.py live Drive demo
# GDRIVE_DEMO_FILE_ID=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
